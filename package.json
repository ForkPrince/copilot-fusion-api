{
  "name": "copilot-fusion-api",
  "version": "0.3.0",
  "description": "Standalone OpenAI-compatible API that routes requests through GitHub Copilot Fusion",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IcyHot09/opencode-copilot-fusion.git"
  },
  "homepage": "https://github.com/IcyHot09/opencode-copilot-fusion#readme",
  "bugs": {
    "url": "https://github.com/IcyHot09/opencode-copilot-fusion/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "copilot-fusion-api": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "github-copilot",
    "copilot-fusion",
    "openai-compatible",
    "api",
    "proxy"
  ],
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 \"test/*.test.js\"",
    "start": "node dist/cli.js serve",
    "login": "node dist/cli.js login",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
